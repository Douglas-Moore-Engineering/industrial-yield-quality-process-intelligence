{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://dmesystems.global/schemas/iyqpis/quality-result/1.0.0",
  "title":"IYQPIS Quality Result",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","event_id","event_time","ingest_time","source_system","plant_id","quality_result_id","measurement_name","disposition"],
  "properties":{
    "schema_version":{"type":"string","const":"1.0.0"},
"event_id":{"type":"string","minLength":1},
"event_time":{"type":"string","format":"date-time"},
"ingest_time":{"type":"string","format":"date-time"},
"source_system":{"type":"string","minLength":1},
"plant_id":{"type":"string","minLength":1},
"line_id":{"type":["string","null"]},
    "quality_result_id":{"type":"string","minLength":1},
    "run_id":{"type":["string","null"]},
    "material_lot_id":{"type":["string","null"]},
    "product_instance_id":{"type":["string","null"]},
    "measurement_name":{"type":"string","minLength":1},
    "measurement_value":{"type":["number","string","null"]},
    "engineering_unit":{"type":["string","null"]},
    "lower_spec_limit":{"type":["number","null"]},
    "upper_spec_limit":{"type":["number","null"]},
    "method_id":{"type":["string","null"]},
    "disposition":{"type":"string","enum":["PASS","FAIL","HOLD","REWORK","SCRAP","RELEASED","UNKNOWN"]}
  }
}