FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f
WORKDIR /app
COPY requirements-data.txt requirements-ml.txt ./
RUN pip install --no-cache-dir -r requirements-ml.txt
COPY src/iyqpis /app/src/iyqpis
COPY data/contracts /app/data/contracts
ENV PYTHONPATH=/app/src PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
USER 10001:10001
ENTRYPOINT ["python", "-m", "iyqpis.azure_intelligence"]
